<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.aerospike.timf</groupId>
  <artifactId>ClusterComparator</artifactId>
  <version>1.3.0</version>
  <name>Cluster Comparator</name>
  <description>Find differences between different Aerospike clusters.</description>
  
	<properties>
		<aerospike-client.verion>10.1.0</aerospike-client.verion>
  		<jackson-dataformat-yaml.version>2.22.1</jackson-dataformat-yaml.version>
  		<!-- Note: This utility is used by people still running on JDK11, so do not upgrade to JUnit 6 yet -->
		<junit-jupiter.version>5.14.2</junit-jupiter.version>
		<commons-cli.version>1.4</commons-cli.version>
		<javalin.version>6.7.0</javalin.version>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

		<!--
		  Default build: an 11-baseline jar. aerospike-client-jdk8 is still the right
		  dependency here even though the baseline is 11, not 8 - Aerospike only
		  publishes two client tiers (jdk8 and jdk21), and the jdk8 one is Java 8
		  bytecode, so it runs fine on 11+. (An actual Java 8 runtime isn't supported
		  by this build: Javalin - the web UI's embedded server - is itself compiled
		  for Java 11+, starting at Javalin 5.0.)
		  The "jdk21" profile below overrides both properties to build a second,
		  separate jar for people specifically on JDK 21+ who want Aerospike's
		  newer-JVM-optimized client (aerospike-client-jdk21, which requires a 21+
		  JRE and will NOT load on anything older).
		-->
		<aerospike-client.artifactId>aerospike-client-jdk8</aerospike-client.artifactId>
		<maven.compiler.release>11</maven.compiler.release>
		<jar.variant>jdk11</jar.variant>
	</properties>

  <dependencies>
      <dependency>
        <groupId>com.aerospike</groupId>
        <artifactId>${aerospike-client.artifactId}</artifactId>
        <version>${aerospike-client.verion}</version>
      </dependency>
		<!-- Commons CLI needed for command line parsing on utilities -->
		<!-- https://mvnrepository.com/artifact/commons-cli/commons-cli -->
		<dependency>
		    <groupId>commons-cli</groupId>
		    <artifactId>commons-cli</artifactId>
		    <version>${commons-cli.version}</version>
		</dependency>
		<dependency>
		    <groupId>com.fasterxml.jackson.dataformat</groupId>
		    <artifactId>jackson-dataformat-yaml</artifactId>
		    <version>${jackson-dataformat-yaml.version}</version>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<version>${junit-jupiter.version}</version>
			<scope>test</scope>
		</dependency>
		<!-- https://mvnrepository.com/artifact/io.github.hakky54/sslcontext-kickstart-for-pem -->
		<!-- This is needed for TLS utilities -->
		<dependency>
		    <groupId>io.github.hakky54</groupId>
		    <artifactId>sslcontext-kickstart-for-pem</artifactId>
		    <version>9.2.1</version>
		</dependency>
		<dependency>
		    <groupId>io.javalin</groupId>
		    <artifactId>javalin</artifactId>
		    <version>${javalin.version}</version>
		</dependency>
		<dependency>
		    <groupId>org.slf4j</groupId>
		    <artifactId>slf4j-simple</artifactId>
		    <version>2.0.18</version>
		</dependency>
  </dependencies>
	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-source-plugin</artifactId>
				<version>3.1.0</version>
				<executions>
					<execution>
						<id>attach-sources</id>
						<goals>
							<goal>jar</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.15.0</version>
				<configuration>
					<!--
					  <release> (not <source>/<target>) so the compiler validates against that
					  JDK's actual API surface even when Maven itself runs on a newer JDK.
					-->
					<release>${maven.compiler.release}</release>
				</configuration>
			</plugin>
			<plugin>
				<artifactId>maven-assembly-plugin</artifactId>
				<configuration>
					<descriptorRefs>
						<descriptorRef>jar-with-dependencies</descriptorRef>
					</descriptorRefs>
					<archive>
						<manifest>
							<addClasspath>true</addClasspath>
							<mainClass>com.aerospike.comparator.ClusterComparator</mainClass>
							<addDefaultImplementationEntries>true</addDefaultImplementationEntries>
							<addDefaultSpecificationEntries>true</addDefaultSpecificationEntries>
						</manifest>
					</archive>
					<finalName>${project.artifactId}-${project.version}-${jar.variant}-full</finalName>
					<appendAssemblyId>false</appendAssemblyId>
				</configuration>
				<executions>
					<execution>
						<id>make-my-jar-with-dependencies</id>
						<phase>package</phase>
						<goals>
							<goal>single</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
		<resources>
			<resource>
				<directory>${project.basedir}/src/main/java</directory>
				<includes>
					<include>**/*.properties</include>
					<include>**/*.xml</include>
				</includes>
			</resource>
			<resource>
				<directory>${project.basedir}/src/main/resources</directory>
				<includes>
					<include>**/*</include>
				</includes>
			</resource>
		</resources>
	</build>

	<profiles>
		<profile>
			<id>build-ui</id>
			<activation>
				<property>
					<name>!skipUi</name>
				</property>
			</activation>
			<build>
				<plugins>
					<plugin>
						<groupId>com.github.eirslett</groupId>
						<artifactId>frontend-maven-plugin</artifactId>
						<version>1.15.1</version>
						<configuration>
							<workingDirectory>${project.basedir}/ui</workingDirectory>
						</configuration>
						<executions>
							<execution>
								<id>install-node-and-npm</id>
								<goals><goal>install-node-and-npm</goal></goals>
								<configuration>
									<nodeVersion>v20.11.0</nodeVersion>
								</configuration>
							</execution>
							<execution>
								<id>npm-install</id>
								<goals><goal>npm</goal></goals>
								<configuration>
									<arguments>install</arguments>
								</configuration>
							</execution>
							<execution>
								<id>npm-build</id>
								<goals><goal>npm</goal></goals>
								<phase>generate-resources</phase>
								<configuration>
									<arguments>run build</arguments>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>

		<!--
		  Builds the alternate jar for people specifically on JDK 21+ who want
		  Aerospike's newer-JVM-optimized client. Requires JDK 21+ to run Maven itself
		  (javac can't target a release higher than its own JDK). Activate with the
		  jdk21 Maven profile.
		-->
		<profile>
			<id>jdk21</id>
			<properties>
				<aerospike-client.artifactId>aerospike-client-jdk21</aerospike-client.artifactId>
				<maven.compiler.release>21</maven.compiler.release>
				<jar.variant>jdk21</jar.variant>
			</properties>
		</profile>
	</profiles>

</project>